-      }
-    });
-    unsubscribers.push(() => sub.unsubscribe());
-  }
-
-  // ─── VANGUARD'S TOKEN: First minion gets +2/+2 ──────────
-
-  if (relicSet.has('VANGUARD_TOKEN')) {
-    const sub = events.subscribe((event: GameEvent) => {
